# RetroFuturism — environment variables
#
# Copy to `.env` and adjust as needed. `.env` is gitignored.
#
# NOTE: This project intentionally has very few runtime env vars. There is no
# auth/session/OAuth layer in the current codebase, so no secrets are required
# to run it.

# Node environment: "development" (default via `npm run dev`) or "production"
# (set automatically by `npm start`). Controls whether Vite dev middleware or
# the prebuilt static client is served.
NODE_ENV=development

# Port the Express server (API + client) listens on. Defaults to 5000.
PORT=5000

# Path of the SQLite database file. Defaults to "data.db" in the working
# directory. Set this to point at a persistent volume in deployment, and use
# the same value when running `npm run db:push` (drizzle.config.ts reads it).
# DATABASE_PATH=/data/data.db

# Comma-separated allowlist of browser origins allowed to call the JSON API
# cross-origin (e.g. "https://example.com,https://app.example.com"). Leave
# unset to deny all cross-origin browser requests (same-origin is unaffected).
# CORS_ORIGIN=
